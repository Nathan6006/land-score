# Copy to .env and edit. .env is gitignored; it holds per-machine settings only.

# Where downloaded and derived data live. Default: ./data inside the repo.
# Put this on a drive with space (pilot ~1 GB, all counties ~6 GB).
LANDSCORE_DATA_DIR=./data

# Where figures, models, and reports are written. Default: ./outputs
LANDSCORE_OUTPUTS_DIR=./outputs

# Set to 1 to run tests that touch the internet.
LANDSCORE_NETWORK_TESTS=0
